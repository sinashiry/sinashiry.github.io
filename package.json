{
  "name": "sina-shiri-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "compose": "node scripts/compose-content.mjs",
    "build": "node scripts/compose-content.mjs && astro build && node scripts/prepare-pages.mjs",
    "dev": "node scripts/compose-content.mjs && astro dev --host 127.0.0.1",
    "start": "astro preview --host 127.0.0.1 --port 4322",
    "check": "node scripts/compose-content.mjs --check && node scripts/generate-pages-config.mjs --check",
    "test": "node --test \"scripts/tests/**/*.test.mjs\"",
    "smoke": "node scripts/smoke-dist.mjs",
    "split": "node scripts/split-content.mjs",
    "pages-config": "node scripts/generate-pages-config.mjs"
  },
  "dependencies": {
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
