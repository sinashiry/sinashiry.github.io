---
import Recommendations from '../components/Recommendations.astro';
import '../styles/evidence.css';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import ProjectCard from '../components/ProjectCard.astro';
import data from '../data/content.json';
const featuredSlugs = ['industrial-alarm-monitoring','fire-smoke-vision','zynq-object-detection','embedded-qr-scanner'];
const featured = featuredSlugs.map(slug => ({ project:data.projects.find(p=>p.slug===slug)!, index:data.projects.findIndex(p=>p.slug===slug) }));
const videoCount = new Set(data.projects.flatMap(p=>(p.videos || []).map(v=>v.src))).size;
const imageCount = new Set(data.projects.flatMap(p=>(p.galleries || []).filter(v=>!v.src.endsWith('/concept-cover.webp')).map(v=>v.src))).size;
const schema={"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://sina-shiri.com/#website","name":"Sina Shiri — Engineering & Research","url":"https://sina-shiri.com/"},{"@type":"ProfilePage","@id":"https://sina-shiri.com/#profile","url":"https://sina-shiri.com/","mainEntity":{"@id":"https://sina-shiri.com/#person"}},{"@type":"Person","@id":"https://sina-shiri.com/#person","name":"Sina Shiri","url":"https://sina-shiri.com/","sameAs":[data.profile.github,data.profile.linkedin],"knowsAbout":["Python","Embedded systems","Hardware security","Computer vision"]}]};
---
<Base><script slot="head" type="application/ld+json" data-cv-schema="profile" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />
<div class="wrap">
<section class="hero hero-v2 portfolio-hero"><div class="hero-copy"><span class="eyebrow"><span class="status-dot" aria-hidden="true"></span> <Text field="profile.eyebrow" /></span><h1><span class="hero-name"><Text field="profile.headlineStart" /></span><span class="hero-role"><Text field="profile.headlineMiddle" /><br /><em><Text field="profile.headlineEnd" /></em></span></h1><p class="intro"><Text field="profile.heroIntro" /></p><div class="hero-now"><span class="mono-label">CURRENT WORK</span><p><Text field="profile.currentFocus" /></p></div><div class="actions hero-routes"><a class="button" href="/projects/">Engineering work <span aria-hidden="true">↗</span></a><a class="button secondary" href="/research/">Research & study <span aria-hidden="true">↗</span></a><a class="hero-cv-link" href="/downloads/Sina_Shiri_Engineering_CV.pdf" download>Engineering CV ↓</a><a class="hero-cv-link" href="/downloads/Sina_Shiri_Masters_CV.pdf" download>Academic CV ↓</a></div><p class="hero-footnote"><Text field="profile.availability" /></p></div>
<div class="hero-object hero-person"><div class="portrait-card" data-tilt><div class="portrait-photo"><img src="/assets/sina-shiri-profile-20261007.webp" width="640" height="640" alt="Sina Shiri" fetchpriority="high" /></div><div class="portrait-caption"><div><span class="eyebrow">THE PERSON BEHIND THE WORK</span><h2><Text field="profile.name" /></h2><p><Text field="profile.location" /></p></div><a href="/contact/" class="portrait-contact" aria-label="Contact Sina Shiri">↗</a></div></div><div class="hero-profile-links" aria-label="Sina’s professional profiles"><a href="/code/">GitHub projects ↗</a><a href={data.profile.linkedin} data-cv-url="profile.linkedin" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`mailto:${data.profile.email}`} data-cv-href="profile.email">Email ↗</a></div></div></section>
<section class="section featured-work" id="work"><div class="section-heading"><div><span class="eyebrow">01 / FEATURED ENGINEERING</span><h2>Software meets<br />the physical world.</h2></div><div><p>Four systems connecting industrial monitoring, vision experiments, programmable logic and production information.</p><div class="link-row"><a href="/projects/">View all engineering projects →</a><a href="/gallery/">Original photos & videos ↗</a></div></div></div><div class="project-grid">{featured.map(({project,index})=><ProjectCard project={project} index={index} />)}</div><p class="cover-disclosure">Project covers are conceptual illustrations. Each case study contains original project photographs, interfaces, demonstrations and contribution credits.</p></section>
<section id="showreel" class="showreel-section" aria-labelledby="showreel-title"><div class="showreel-copy"><span class="eyebrow">ORIGINAL PROJECT ARCHIVE</span><h2 id="showreel-title">See the systems<br /><em>in operation.</em></h2><p>A silent edit of archival demonstrations: physical devices, software interfaces and prototypes. The case studies explain what each recording shows.</p><div class="reel-facts"><span><strong>{data.projects.length}</strong> case studies</span><span><strong>{videoCount}</strong> demonstrations</span><span><strong>{imageCount}</strong> project images</span></div></div><figure class="showreel-player"><video src="/assets/project-showreel.mp4" poster="/assets/project-showreel-poster.jpg" controls playsinline preload="none" aria-label="Archival showreel of industrial monitoring, QR scanning, computer vision and polling devices"></video><figcaption><span>ARCHIVAL FOOTAGE · SILENT EDIT</span><a href="/gallery/">Full project archive ↗</a></figcaption></figure></section>
<section id="research" class="research-band" aria-labelledby="research-heading"><div><span class="eyebrow">02 / RESEARCH & ACADEMIC EVIDENCE</span><h2 id="research-heading">A vision algorithm.<br />An embedded implementation.</h2><p><Text field="projects.5.summary" /></p><div class="actions"><a class="button light" href="/research/">Research & academic background</a><a class="text-link" href="/downloads/Sina_Shiri_Masters_CV.pdf" download>Academic CV ↓</a></div></div><div class="research-list"><div><strong>Zynq undergraduate thesis</strong><span><a href="/projects/zynq-object-detection/">Source, report & demonstrations ↗</a></span></div><div><strong>Technical communication</strong><span><a href="/research/#technical-books">Co-authored Raspberry Pi references ↗</a></span></div><div><strong>Current work</strong><span><Text field="profile.currentFocus" /></span></div></div></section>
<Recommendations />
<section class="contact-band home-contact" id="contact"><div><span class="eyebrow">CONTINUE THE CONVERSATION</span><h2>A role, a research question<br />or a system to build.</h2><p><Text field="contact.summary" /></p></div><div class="actions"><a class="button" href="/contact/">Contact Sina ↗</a><a class="text-link" href="/about/">Experience & capabilities ↗</a></div></section>
</div></Base>
