---
import AcademicProfiles from '../components/AcademicProfiles.astro';
import AcademicReferences from '../components/AcademicReferences.astro';
import TechnicalSkills from '../components/TechnicalSkills.astro';
import ContactCards from '../components/ContactCards.astro';
import Honors from '../components/Honors.astro';
import Base from '../layouts/Base.astro';import Text from '../components/Text.astro';import data from '../data/content.json';
---
<Base title="Résumé & CV Downloads — Sina Shiri" description="Download Sina Shiri’s engineering and academic CVs, with experience, electrical-engineering education, original-scale GPAs and technical projects." active="resume"><div class="wrap"><section class="page-intro"><span class="eyebrow">RÉSUMÉ / TWO PERSPECTIVES, ONE BACKGROUND</span><h1>The experience.<br />Ready to take with you.</h1><p>Electrical engineering, practical embedded systems experience, and a growing research focus in hardware security.</p></section><div class="download-grid"><article class="panel download-card"><span class="eyebrow">FOR MASTER’S PROGRAMMES</span><h2>Academic CV</h2><p>Education, original-scale GPAs, research interests, technical projects, and published books.</p><div class="actions"><a class="button" href="/downloads/Sina_Shiri_Masters_CV.pdf" download>Download PDF</a><a class="cv-source-link" href="/downloads/Sina_Shiri_Masters_CV.tex" download>View source</a></div><p class="download-meta">2 pages · A4 · Text-selectable PDF</p></article><article class="panel download-card"><span class="eyebrow">FOR ENGINEERING TEAMS</span><h2>Engineering CV</h2><p>Professional experience, technical skills, and selected software and embedded systems projects.</p><div class="actions"><a class="button" href="/downloads/Sina_Shiri_Engineering_CV.pdf" download>Download PDF</a><a class="cv-source-link" href="/downloads/Sina_Shiri_Engineering_CV.tex" download>View source</a></div><p class="download-meta">2 pages · A4 · Text-selectable PDF</p></article></div><section class="section"><div class="content-grid"><div><h2>Experience</h2><div style="margin-top:30px">{data.experience.map((e,i)=><article class="timeline-item"><span class="period"><Text field={`experience.${i}.period`} /></span><h3><Text field={`experience.${i}.role`} /></h3><strong><Text field={`experience.${i}.organization`} /></strong><p><Text field={`experience.${i}.summary`} /></p></article>)}</div></div><div><h2>Education</h2><div style="margin-top:30px">{data.education.map((e,i)=><article class="timeline-item"><span class="period"><Text field={`education.${i}.period`} /></span><h3><Text field={`education.${i}.degree`} /></h3><p><Text field={`education.${i}.institution`} /></p><p>GPA <strong><Text field={`education.${i}.gpa`} /></strong></p></article>)}</div><p><Text field="contact.referencesNote" /></p></div></div></section><AcademicProfiles /><AcademicReferences /><TechnicalSkills id="skills" /><Honors id="honors" entries={data.honors} /><ContactCards id="contact" /></div></Base>
