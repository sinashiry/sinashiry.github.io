---
import TechnicalSkills from '../components/TechnicalSkills.astro';
import Base from '../layouts/Base.astro';import Text from '../components/Text.astro';import data from '../data/content.json';
const examples=[['/research/','Research & academic background'],['/projects/industrial-alarm-monitoring/','Industrial monitoring case'],['/projects/two-line-caller-id/','Caller-ID application']];
---
<Base title="About Sina Shiri — Engineering, experience & skills" description="Sina Shiri’s professional experience at IstaSanat, independent hardware-security work, engineering capabilities and language background." active="about"><div class="wrap"><section class="page-intro"><span class="eyebrow">ABOUT / SINA SHIRI</span><h1>From electronics<br />to useful software.</h1><p><Text field="profile.summary" /></p></section><div class="content-grid"><div><div class="prose"><h2>Professional experience</h2></div>{data.experience.map((e,i)=><article class="timeline-item"><span class="period"><Text field={`experience.${i}.period`} /></span><h3><Text field={`experience.${i}.role`} /></h3><strong><Text field={`experience.${i}.organization`} /></strong><p><Text field={`experience.${i}.summary`} /></p>{e.highlights.length > 0 && <ul>{e.highlights.map((_,j)=><li><Text field={`experience.${i}.highlights.${j}`} /></li>)}</ul>}<div class="link-row"><a href={examples[i][0]}>{examples[i][1]} ↗</a>{i===1 && <a href="/projects/embedded-qr-scanner/">Embedded production interface ↗</a>}{i===2 && <a href="/research/#technical-books">Co-authored technical books ↗</a>}</div></article>)}</div><aside><div class="portrait-frame"><img src="/assets/sina-shiri-profile-20261007.webp" width="640" height="640" alt="Sina Shiri" /></div><div class="panel" style="margin-top:24px"><h2>At a glance</h2><dl><div class="meta-row"><dt>Based in</dt><dd><Text field="profile.location" /></dd></div><div class="meta-row"><dt>Current work</dt><dd><Text field="profile.currentFocus" /></dd></div><div class="meta-row"><dt>Languages</dt><dd>{data.languages.map((l,i)=><p><strong><Text field={`languages.${i}.name`} /></strong> — <Text field={`languages.${i}.level`} /></p>)}</dd></div></dl><div class="link-row"><a href={data.profile.github} data-cv-url="profile.github" rel="me noreferrer">GitHub</a><a href={data.profile.linkedin} data-cv-url="profile.linkedin" rel="me noreferrer">LinkedIn</a></div></div></aside></div><TechnicalSkills id="engineering-capabilities" /></div></Base>
