---
import data from '../data/content.json';
import Text from './Text.astro';
import '../styles/evidence.css';
const populated=data.recommendations.entries.some(entry=>entry.approved==='yes' && [entry.quote,entry.name,entry.status].every(value=>value.trim()));
---
<section data-cv-group="recommendations" data-cv-group-state={populated ? 'ready' : 'empty'} class="recommendations-section" id="recommendations" aria-labelledby="recommendations-title">
  <header><span class="eyebrow">COLLABORATION</span><h2 id="recommendations-title"><Text field="recommendations.title" /></h2></header>
  <div class="recommendation-list">{data.recommendations.entries.map((entry, index) => <figure class="recommendation-card" data-recommendation-slot={index} data-recommendation-state={entry.approved === 'yes' && [entry.quote,entry.name,entry.status].every(v=>v.trim()) ? 'ready' : 'empty'}><blockquote><Text field={`recommendations.entries.${index}.quote`} /></blockquote><figcaption><strong><Text field={`recommendations.entries.${index}.name`} /></strong><span><Text field={`recommendations.entries.${index}.status`} /></span><small><Text field={`recommendations.entries.${index}.relationship`} /></small><p data-cv-visible={`recommendations.entries.${index}.organization`}><Text field={`recommendations.entries.${index}.organization`} /></p><p data-cv-visible={`recommendations.entries.${index}.context`}><Text field={`recommendations.entries.${index}.context`} /></p><p data-cv-visible={`recommendations.entries.${index}.date`}><Text field={`recommendations.entries.${index}.date`} /></p><p data-cv-visible={`recommendations.entries.${index}.url`}><a href={entry.url} data-cv-url={`recommendations.entries.${index}.url`} rel="noopener noreferrer">Professional profile ↗</a></p></figcaption></figure>)}</div>
  <div class="recommendation-invitation"><span class="recommendation-mark" aria-hidden="true">“</span><div><p class="recommendation-intro"><Text field="recommendations.intro" /></p><p><Text field="recommendations.invitation" /></p><a class="button secondary" href={`mailto:${data.profile.email}`} data-cv-href="profile.email"><Text field="recommendations.action" /><span aria-hidden="true">↗</span></a></div><aside><h3>A helpful recommendation includes</h3><ul><li>The project or context we shared</li><li>My specific contribution</li><li>Your name, role and organisation</li><li>Permission to publish your words</li></ul></aside></div>
</section>
