---
import data from '../data/content.json';
import Text from './Text.astro';
import '../styles/profile-sections.css';

interface Props {
  id?: string;
  heading?: string | false;
  eyebrow?: string;
}
const { id, heading = 'Engineering capabilities', eyebrow = 'WHERE I CONTRIBUTE' } = Astro.props;
const examples=[['industrial-alarm-monitoring','networked-polling','two-line-caller-id'],['embedded-qr-scanner','rfid-attendance','food-reservation-system'],['zynq-object-detection','fire-smoke-vision'],['industrial-data-graph']];
const icons = [
  'm8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  'M8 4v3m8-3v3M8 17v3m8-3v3M4 8h3m10 0h3M4 16h3m10 0h3M7 7h10v10H7zM10 10h4v4h-4z',
  'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zm7 0a3 3 0 1 0 6 0 3 3 0 1 0-6 0',
  'M4 5h16M4 12h16M4 19h16M8 3v4m8 3v4M10 17v4',
];
---

<section class="profile-section technical-skills" id={id} aria-labelledby={heading && id ? `${id}-title` : undefined} aria-label={!id || !heading ? 'Technical skills' : undefined}>
  {heading && <header class="profile-section-heading"><div><span class="eyebrow">{eyebrow}</span><h2 id={id ? `${id}-title` : undefined}>{heading}</h2></div></header>}
  <div class="technical-skill-rows">
    {data.skillGroups.map((group, index) => (
      <div class="technical-skill-row">
        <div class="technical-skill-category">
          <span class="profile-line-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index % icons.length]} /></svg></span>
          <h3><Text field={`skillGroups.${index}.name`} /></h3>
        </div>
        <div class="technical-skill-evidence"><ul class="technical-skill-chips" aria-label={group.name}>
          {group.skills.map((_, skillIndex) => <li><Text field={`skillGroups.${index}.skills.${skillIndex}`} /></li>)}
        </ul><div class="capability-projects" aria-label={`Project evidence for ${group.name}`}><span>Project evidence</span>{examples[index].map(slug=>{const projectIndex=data.projects.findIndex(project=>project.slug===slug);return <a href={`/projects/${slug}/`}><Text field={`projects.${projectIndex}.title`} /> ↗</a>;})}</div></div>
      </div>
    ))}
  </div>
</section>
